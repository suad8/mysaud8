// مخطط قاعدة بيانات المتجر الإلكتروني
// كل المبالغ Decimal(12,2) — لا Float مطلقاً في الحسابات المالية.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// الكتالوج
// ─────────────────────────────────────────────────────────────

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  nameAr      String
  nameEn      String?
  descAr      String?
  imageUrl    String?
  position    Int        @default(0)
  isActive    Boolean    @default(true)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
  @@index([isActive, position])
}

model Brand {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameAr    String
  nameEn    String?
  logoUrl   String?
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameAr      String
  nameEn      String?
  /// وصف قصير يظهر في البطاقات ونتائج البحث
  shortDescAr String?
  descAr      String?
  descEn      String?

  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  brandId     String?
  brand       Brand?    @relation(fields: [brandId], references: [id])

  status      ProductStatus @default(DRAFT)
  isFeatured  Boolean       @default(false)

  /// السعر الأساسي (شامل الضريبة) — المتغيّرات قد تتجاوزه
  basePrice   Decimal  @db.Decimal(12, 2)
  /// السعر قبل التخفيض، للعرض المشطوب. null = لا تخفيض
  comparePrice Decimal? @db.Decimal(12, 2)
  /// التكلفة — للتقارير فقط، لا تظهر للعميل أبداً
  costPrice   Decimal? @db.Decimal(12, 2)

  metaTitle   String?
  metaDesc    String?

  images      ProductImage[]
  variants    ProductVariant[]
  reviews     Review[]
  orderItems  OrderItem[]
  cartItems   CartItem[]
  wishlisted  WishlistItem[]

  /// حذف ناعم — الطلبات القديمة ما زالت تشير لهذا المنتج
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, isFeatured])
  @@index([categoryId, status])
  @@index([deletedAt])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)

  @@index([productId, position])
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String   @unique
  nameAr     String
  /// خيارات المتغيّر: { "اللون": "أسود", "المقاس": "L" }
  options    Json     @default("{}")
  price      Decimal  @db.Decimal(12, 2)
  comparePrice Decimal? @db.Decimal(12, 2)
  barcode    String?
  weightGram Int?
  isActive   Boolean  @default(true)

  inventory  InventoryItem?
  orderItems OrderItem[]
  cartItems  CartItem[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId, isActive])
}

// ─────────────────────────────────────────────────────────────
// المخزون
// ─────────────────────────────────────────────────────────────

model InventoryItem {
  id        String         @id @default(cuid())
  variantId String         @unique
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /// الكمية الفعلية في المستودع
  onHand    Int            @default(0)
  /// محجوزة لطلبات قيد الدفع — المتاح = onHand - reserved
  reserved  Int            @default(0)
  /// حد التنبيه بانخفاض المخزون
  lowStockAt Int           @default(5)
  /// السماح بالبيع عند نفاد المخزون
  allowBackorder Boolean   @default(false)

  movements InventoryMovement[]
  updatedAt DateTime       @updatedAt
}

model InventoryMovement {
  id          String        @id @default(cuid())
  inventoryId String
  inventory   InventoryItem @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  /// موجب = إدخال، سالب = صرف
  delta       Int
  reason      String
  /// رقم الطلب أو مرجع التعديل اليدوي
  reference   String?
  createdAt   DateTime      @default(now())

  @@index([inventoryId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// العملاء
// ─────────────────────────────────────────────────────────────

model Customer {
  id           String    @id @default(cuid())
  email        String?   @unique
  phone        String?   @unique
  name         String?
  passwordHash String?
  isGuest      Boolean   @default(false)
  acceptsMarketing Boolean @default(false)

  addresses    Address[]
  orders       Order[]
  carts        Cart[]
  reviews      Review[]
  wishlist     WishlistItem[]

  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  city       String
  district   String?
  street     String
  details    String?
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

// ─────────────────────────────────────────────────────────────
// السلة
// ─────────────────────────────────────────────────────────────

model Cart {
  id         String     @id @default(cuid())
  /// معرّف الجلسة للزوار غير المسجلين
  sessionId  String?    @unique
  customerId String?
  customer   Customer?  @relation(fields: [customerId], references: [id])
  items      CartItem[]
  couponCode String?
  status     CartStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([customerId, status])
  @@index([status, updatedAt])
}

enum CartStatus {
  ACTIVE
  /// تُركت دون إتمام — مصدر تقرير السلات المتروكة
  ABANDONED
  CONVERTED
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id])
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  createdAt DateTime       @default(now())

  @@unique([cartId, variantId])
}

// ─────────────────────────────────────────────────────────────
// الطلبات
// ─────────────────────────────────────────────────────────────

model Order {
  id          String      @id @default(cuid())
  /// رقم الطلب المعروض للعميل — متسلسل وقابل للقراءة
  number      String      @unique
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id])

  status      OrderStatus @default(PENDING)

  // لقطة بيانات التواصل والشحن وقت الطلب
  email       String?
  phone       String
  shipToName  String
  shipToCity  String
  shipToDistrict String?
  shipToStreet String
  shipToDetails String?

  // كل المبالغ محسوبة ومحفوظة — لا يُعاد حسابها عند العرض
  subtotal      Decimal @db.Decimal(12, 2)
  discountTotal Decimal @db.Decimal(12, 2) @default(0)
  shippingTotal Decimal @db.Decimal(12, 2) @default(0)
  taxTotal      Decimal @db.Decimal(12, 2) @default(0)
  grandTotal    Decimal @db.Decimal(12, 2)
  currency      String  @default("SAR")

  couponCode  String?
  customerNote String?
  /// الرقم الضريبي الاختياري للعميل — لإصدار فاتورة ضريبية للشركات، لا يغيّر المبلغ المدفوع
  taxNumber   String?
  /// ملاحظات الموظفين — لا تظهر للعميل
  internalNote String?

  items       OrderItem[]
  payments    Payment[]
  shipments   Shipment[]
  events      OrderEvent[]

  placedAt    DateTime    @default(now())
  paidAt      DateTime?
  cancelledAt DateTime?
  updatedAt   DateTime    @updatedAt

  @@index([status, placedAt])
  @@index([customerId, placedAt])
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])

  // لقطة وقت الشراء — تغيير المنتج لاحقاً لا يمس الفواتير القديمة
  nameAr      String
  sku         String
  imageUrl    String?
  options     Json            @default("{}")
  unitPrice   Decimal         @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal         @db.Decimal(12, 2)

  @@index([orderId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// نص يصف ما حدث: "تم الدفع"، "تم الشحن"…
  message   String
  status    OrderStatus?
  /// معرّف المستخدم الإداري، أو null إذا كان النظام
  actorId   String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// الدفع
// ─────────────────────────────────────────────────────────────

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String
  /// معرّف العملية لدى البوابة
  providerRef String?
  method      PaymentMethod
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("SAR")
  status      PaymentStatus @default(INITIATED)
  /// رد البوابة الخام — للتدقيق عند النزاعات
  rawResponse Json?
  failureReason String?
  /// رابط إيصال التحويل البنكي المرفوع من العميل (لطريقة الدفع BANK_TRANSFER)
  receiptUrl  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orderId])
  @@index([provider, providerRef])
}

enum PaymentMethod {
  MADA
  CREDIT_CARD
  APPLE_PAY
  STC_PAY
  TABBY
  TAMARA
  COD
  BANK_TRANSFER
}

enum PaymentStatus {
  INITIATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// سجل أحداث البوابات — يمنع معالجة نفس الحدث مرتين
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  /// المعرّف الفريد للحدث لدى البوابة
  externalId  String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime @default(now())

  @@unique([provider, externalId])
}

// ─────────────────────────────────────────────────────────────
// الشحن
// ─────────────────────────────────────────────────────────────

model ShippingZone {
  id        String         @id @default(cuid())
  nameAr    String
  /// قائمة المدن المشمولة بهذه المنطقة
  cities    String[]
  isActive  Boolean        @default(true)
  rates     ShippingRate[]
  createdAt DateTime       @default(now())
}

model ShippingRate {
  id       String       @id @default(cuid())
  zoneId   String
  zone     ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  nameAr   String
  price    Decimal      @db.Decimal(12, 2)
  /// شحن مجاني إذا تجاوز إجمالي الطلب هذا المبلغ. null = لا يوجد
  freeAbove Decimal?    @db.Decimal(12, 2)
  minDays  Int?
  maxDays  Int?
  isActive Boolean      @default(true)

  @@index([zoneId, isActive])
}

model Shipment {
  id           String    @id @default(cuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier      String
  trackingNo   String?
  trackingUrl  String?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────
// الخصومات
// ─────────────────────────────────────────────────────────────

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  type          DiscountType
  /// نسبة مئوية أو مبلغ ثابت حسب النوع
  value         Decimal      @db.Decimal(12, 2)
  minSubtotal   Decimal?     @db.Decimal(12, 2)
  /// أقصى خصم بالريال عند النوع النسبي
  maxDiscount   Decimal?     @db.Decimal(12, 2)
  usageLimit    Int?
  usageCount    Int          @default(0)
  perCustomerLimit Int?
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())

  @@index([code, isActive])
}

enum DiscountType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

// ─────────────────────────────────────────────────────────────
// التقييمات
// ─────────────────────────────────────────────────────────────

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  authorName String
  rating     Int
  comment    String?
  /// لا يظهر التقييم في المتجر قبل الاعتماد
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId, isApproved])
}

// ─────────────────────────────────────────────────────────────
// الإدارة
// ─────────────────────────────────────────────────────────────

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         AdminRole  @default(STAFF)
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum AdminRole {
  OWNER
  MANAGER
  STAFF
}

model AuditLog {
  id        String    @id @default(cuid())
  actorId   String?
  actor     AdminUser? @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  /// لقطة قبل/بعد للتغيير
  diff      Json?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

/// إعدادات المتجر — مفتاح/قيمة لتجنّب ترحيل لكل إعداد جديد
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
