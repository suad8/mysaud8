# ─── قاعدة البيانات ───────────────────────────────────────────
DATABASE_URL="postgresql://mysaud8:mysaud8_dev@localhost:5432/mysaud8?schema=public"

# ─── التطبيق ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# مفتاح توقيع الجلسات — ولّده بـ: openssl rand -base64 32
SESSION_SECRET=""

# ─── المتجر ───────────────────────────────────────────────────
NEXT_PUBLIC_STORE_NAME="فنجان"
NEXT_PUBLIC_CURRENCY="SAR"
# نسبة ضريبة القيمة المضافة
TAX_RATE="0.15"

# ─── بوابات الدفع ─────────────────────────────────────────────
# Moyasar — مدى، بطاقات، Apple Pay، STC Pay
MOYASAR_PUBLISHABLE_KEY=""
MOYASAR_SECRET_KEY=""
MOYASAR_WEBHOOK_SECRET=""

# Tabby — التقسيط
TABBY_PUBLIC_KEY=""
TABBY_SECRET_KEY=""

# ─── التخزين (S3-compatible) ─────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="mysaud8"
S3_ACCESS_KEY="mysaud8"
S3_SECRET_KEY="mysaud8_dev"
S3_REGION="us-east-1"

# ─── البريد ───────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="no-reply@example.com"

# ─── الذكاء الاصطناعي: صور المنتجات ووصفها (اختياري) ─────────────
# مفتاح من https://aistudio.google.com/apikey — يُضبط في متغيرات Railway فقط، لا يُرفع للمستودع
GEMINI_API_KEY=""
# نموذج الصور (اتركه فارغاً للافتراضي gemini-2.5-flash-image)
GEMINI_IMAGE_MODEL=""
# نموذج كتابة الوصف (اتركه فارغاً للافتراضي gemini-2.5-flash)
GEMINI_TEXT_MODEL=""
